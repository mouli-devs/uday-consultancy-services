<svg xmlns="http://www.w3.org/2000/svg" width="400" height="250" viewBox="0 0 400 250">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#12386b;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#061528;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#c89b2c;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#e8c56d;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="250" fill="url(#bg)"/>
  <g transform="translate(200, 125)">
    <path d="M-40,-20 L40,-20 L40,20 Q0,40 -40,20 Z" fill="none" stroke="url(#accent)" stroke-width="3"/>
    <path d="M-25,-10 Q0,-30 25,-10" fill="none" stroke="url(#accent)" stroke-width="3" stroke-linecap="round"/>
    <circle cx="0" cy="-10" r="8" fill="url(#accent)"/>
    <rect x="-8" y="8" width="16" height="3" rx="1.5" fill="url(#accent)"/>
    <rect x="-8" y="15" width="16" height="3" rx="1.5" fill="url(#accent)"/>
  </g>
  <text x="200" y="210" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" fill="#c89b2c" font-weight="600">FSSAI Licence</text>
</svg>