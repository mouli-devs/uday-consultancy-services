<svg xmlns="http://www.w3.org/2000/svg" width="400" height="250" viewBox="0 0 400 250">
  <defs>
    <linearGradient id="bg2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#12386b;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#061528;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="accent2" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#c89b2c;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#e8c56d;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="250" fill="url(#bg2)"/>
  <g transform="translate(200, 125)">
    <!-- Document stack icon -->
    <rect x="-50" y="-40" width="100" height="70" rx="3" fill="none" stroke="url(#accent2)" stroke-width="3"/>
    <rect x="-40" y="-35" width="80" height="5" fill="url(#accent2)"/>
    <rect x="-40" y="-25" width="60" height="5" fill="url(#accent2)" opacity="0.7"/>
    <rect x="-40" y="-15" width="80" height="5" fill="url(#accent2)" opacity="0.5"/>
    <rect x="-40" y="-5" width="50" height="5" fill="url(#accent2)" opacity="0.3"/>
    <rect x="-40" y="5" width="70" height="5" fill="url(#accent2)" opacity="0.6"/>
  </g>
  <text x="200" y="210" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" fill="#c89b2c" font-weight="600">ISO 17025 Documentation</text>
</svg>