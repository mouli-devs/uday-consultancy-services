<svg xmlns="http://www.w3.org/2000/svg" width="400" height="250" viewBox="0 0 400 250">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#12386b;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#061528;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#c89b2c;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#e8c56d;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="250" fill="url(#bg)"/>
  <g transform="translate(200, 125)">
    <rect x="-45" y="-30" width="90" height="50" rx="3" fill="none" stroke="url(#accent)" stroke-width="3"/>
    <rect x="-35" y="-23" width="70" height="8" rx="2" fill="url(#accent)" opacity="0.3"/>
    <rect x="-35" y="-12" width="50" height="8" rx="2" fill="url(#accent)" opacity="0.5"/>
    <rect x="-35" y="-1" width="60" height="8" rx="2" fill="url(#accent)" opacity="0.7"/>
    <rect x="-35" y="10" width="40" height="8" rx="2" fill="url(#accent)" opacity="0.4"/>
    <path d="M-20,20 L0,10 L20,20" fill="none" stroke="url(#accent)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
    <circle cx="0" cy="20" r="8" fill="url(#accent)"/>
    <text x="0" y="25" text-anchor="middle" font-family="Arial" font-size="10" font-weight="bold" fill="#061528">✓</text>
  </g>
  <text x="200" y="210" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" fill="#c89b2c" font-weight="600">FSSAI Compliance Audit</text>
</svg>